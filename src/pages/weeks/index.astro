---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import FinalPresentation from "../../components/FinalPresentation.astro";
import { courseWeeks } from "../../data/course";
---

<BaseLayout title="每週教材｜AI × 量化交易" active="weeks">
  <header class="page-hero"><div class="container"><p class="page-kicker">7 週・每週 3 堂</p><h1>每週教材</h1><p>每週三堂各50分鐘，包含概念圖解、教師示範、個人實作、小組整合與成果驗收。</p></div></header>
  <section class="section">
    <div class="container week-index">
      {courseWeeks.map((item) => (
        <a class="week-link" href={`/weeks/${item.slug}/`}>
          <span class="day-label">第 {item.week} 週<small>第 {item.campusWeek} 週</small></span>
          <span><h2>{item.title}</h2><p>{item.summary}</p><em>交付：{item.groupDeliverable}</em></span>
          <span class="arrow"><ArrowIcon /></span>
        </a>
      ))}
    </div>
    <div class="container final-index"><FinalPresentation compact /></div>
  </section>
</BaseLayout>
