---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArrowIcon from "../../components/ArrowIcon.astro";
import FlowDiagram from "../../components/FlowDiagram.astro";
import FinalPresentation from "../../components/FinalPresentation.astro";
import ClassSchedule from "../../components/ClassSchedule.astro";
import LearningVisual from "../../components/LearningVisual.astro";
import { classPeriods, courseWeeks, type CourseWeek } from "../../data/course";

export function getStaticPaths() {
  return courseWeeks.flatMap((item) => [
    { params: { day: item.slug }, props: { item } },
    { params: { day: `day-${item.week}` }, props: { item } }
  ]);
}
interface Props { item: CourseWeek }
const { item } = Astro.props;
const next = courseWeeks.find((week) => week.week === item.week + 1);
---

<BaseLayout title={`第 ${item.week} 週 ${item.title}｜AI × 量化交易`} active="weeks">
  <div class="lesson-shell">
    <nav class="day-rail" aria-label="課程週次">
      {courseWeeks.map((week) => <a href={`/weeks/${week.slug}/`} aria-current={week.slug === item.slug ? "page" : undefined}>第 {week.week} 週<small>校定第 {week.campusWeek} 週</small></a>)}
    </nav>
    <article class="lesson-main">
      <p class="page-kicker">第 {item.week} 週｜校定第 {item.campusWeek} 週</p>
      <h1>{item.title}</h1><p class="lesson-summary">{item.summary}</p>
      <div class="lesson-meta"><span>3 堂課</span><span>14:20–17:20</span><span>150分鐘教學＋10分鐘驗收</span></div>
      <p><a class="text-link" href={`/resources/#downloads`}>前往每週講義下載 →</a></p>
      <ClassSchedule compact />

      <section class="content-section"><h2>這一週會完成什麼</h2><ul class="goal-list">{item.goals.map((goal) => <li>{goal}</li>)}</ul></section>
      {item.week === 1 && <section class="content-section">
        <h2>銜接前段課程：選一個可驗證的題目</h2>
        <p>可從已介紹的期貨商品、選擇權、技術分析、籌碼與市場結構等主題擇一出發；不預設每位同學已有相同工具能力。先以紙上研究畫布寫出問題、資料需求與可能失敗的情況。</p>
        <ul class="goal-list">
          <li>技術分析與波段策略：把「突破」或「趨勢」改寫成可逐筆判斷的規則。</li>
          <li>籌碼與市場結構：先核對資料何時公開，避免把事後公布的數字提前使用。</li>
          <li>期貨與選擇權：比較契約、交易成本、損益結構及研究資料可用性。</li>
          <li>總經市場分析：界定事件、公告時點、比較基準及可能干擾因素。</li>
        </ul>
        <p>本週只完成研究問題與系統地圖；不要求登入 API 或提交真實績效。第三週才進入教師示範的行情取得與資料驗證。</p>
      </section>}
      {item.visual && <section class="content-section visual-guide-section"><h2>先看懂這一週的路徑</h2><LearningVisual visual={item.visual} steps={item.flow} /></section>}
      <section class="content-section"><h2>核心概念</h2><div class="concept-rail">{item.concepts.map((concept, index) => <div><span>{String(index + 1).padStart(2, "0")}</span><strong>{concept}</strong></div>)}</div></section>
      <section class="content-section"><h2>系統流程圖</h2><FlowDiagram items={item.flow} label={`${item.title}流程`} /></section>
      <section class="content-section"><h2>三堂課安排</h2><div class="agenda">{item.lessons.map((lesson, index) => <div class="agenda-row"><div class="agenda-title"><strong>第 {index + 1} 堂｜{classPeriods[index].time}</strong>{lesson.title}</div><div class="agenda-detail">{lesson.detail}<small>{lesson.minutes} 分鐘</small></div></div>)}</div></section>
      <section class="content-section"><h2>課堂實作與學習證據</h2><div class="evidence-grid"><article><span>實作任務</span><p>{item.practice}</p></article><article><span>個人證據</span><p>{item.individualEvidence}</p></article><article><span>小組交付</span><p>{item.groupDeliverable}</p></article></div>{item.code && <pre class="code-block"><code>{item.code}</code></pre>}</section>
      <aside class="checkpoint"><strong>本週驗收標準</strong><p>{item.checkpoint}</p></aside>
      {next ? <a class="next-unit" href={`/weeks/${next.slug}/`}><span>下一週：{next.title}</span><ArrowIcon /></a> : <div class="week-seven-final"><FinalPresentation compact /></div>}
    </article>
    <aside class="resource-rail" aria-label="學習資源"><h2>學習資源</h2><a class="resource-link" href="/resources/"><span>課前環境與API</span><ArrowIcon size={19} /></a><a class="resource-link" href="/resources/#method"><span>AI協作檢核法</span><ArrowIcon size={19} /></a><a class="resource-link" href="/assignments/"><span>專題與評量規範</span><ArrowIcon size={19} /></a></aside>
  </div>
</BaseLayout>
