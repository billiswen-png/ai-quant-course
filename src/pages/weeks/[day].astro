---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { courseDays, type CourseDay } from "../../data/course";

export function getStaticPaths() {
  return courseDays.map((item) => ({ params: { day: item.slug }, props: { item } }));
}

interface Props { item: CourseDay; }
const { item } = Astro.props;
const next = courseDays.find((day) => day.day === item.day + 1);
---

<BaseLayout title={`Day ${item.day} ${item.title}｜AI 量化交易`} active="weeks">
  <div class="lesson-shell">
    <nav class="day-rail" aria-label="課程日次">
      {courseDays.map((day) => (
        <a href={`/weeks/${day.slug}/`} aria-current={day.slug === item.slug ? "page" : undefined}>Day {day.day}</a>
      ))}
    </nav>
    <article class="lesson-main">
      <h1>Day {item.day}｜{item.title}</h1>
      <p class="lesson-summary">{item.summary}</p>
      <div class="lesson-meta"><span>2 堂課</span><span>約 120 分鐘</span><span>小組實作</span></div>

      <section class="content-section">
        <h2>本日學習目標</h2>
        <ul class="goal-list">{item.goals.map((goal) => <li>{goal}</li>)}</ul>
      </section>

      <section class="content-section">
        <h2>課程安排</h2>
        <div class="agenda">
          {item.lessons.map((lesson, index) => (
            <div class="agenda-row"><div class="agenda-title">第 {index + 1} 堂｜{lesson.title}</div><div class="agenda-detail">{lesson.detail}</div></div>
          ))}
        </div>
      </section>

      <section class="content-section">
        <h2>課堂實作</h2>
        <p>{item.practice}</p>
        {item.code && <pre class="code-block"><code>{item.code}</code></pre>}
        <p><strong>本日成果：</strong>{item.deliverable}</p>
      </section>

      {next ? (
        <a class="next-unit" href={`/weeks/${next.slug}/`}><span>下一單元：Day {next.day} {next.title}</span><span aria-hidden="true">→</span></a>
      ) : (
        <a class="next-unit" href="/assignments/"><span>完成課程：查看期末專題規範</span><span aria-hidden="true">→</span></a>
      )}
    </article>
    <aside class="resource-rail" aria-label="學習資源">
      <h2>學習資源</h2>
      <a class="resource-link" href="/resources/"><span>查看課前準備</span><span>→</span></a>
      <a class="resource-link" href="/resources/#code"><span>開啟程式範例</span><span>→</span></a>
      <a class="resource-link" href="/assignments/"><span>查看作業說明</span><span>→</span></a>
    </aside>
  </div>
</BaseLayout>
