---
import { courseWeeks } from "../data/course";
const weeks = [...courseWeeks.map(({week, title}) => ({week, title})), {week: 8, title: "正式成果發表"}];
---
<section id="downloads" class="handouts" aria-labelledby="downloads-title">
  <p class="page-kicker">課堂投影・課後複習</p>
  <h2 id="downloads-title" class="section-heading">每週講義下載</h2>
  <p>下載高畫質 PDF 後即可離線閱讀與投影。上課前請先下載，並確認版本與更新日期。</p>
  <p id="handout-status" role="status" aria-live="polite">正在查詢已發布講義…</p>
  <div class="handout-grid">
    {weeks.map(({week, title}) => (
      <article class="handout" data-week={week}>
        <span>第 {week} 週</span><h3>{title}</h3>
        <p class="handout-state">查詢中…</p>
        <ul class="handout-files" aria-label={`第 ${week} 週講義檔案`}></ul>
      </article>
    ))}
  </div>
  <p><a class="text-link" href="https://github.com/billiswen-png/ai-quant-course/releases" target="_blank" rel="noopener noreferrer">前往 GitHub 查看所有版本 ↗</a></p>
  <noscript><p>請啟用 JavaScript，或使用上方連結到 GitHub 下載已發布講義。</p></noscript>
</section>
<script>
  import { getHandoutFiles, type HandoutRelease } from "../data/handouts";
  type Release = HandoutRelease & {tag_name: string; draft: boolean; prerelease: boolean; published_at: string};
  const status = document.querySelector<HTMLElement>("#handout-status");
  const cards = [...document.querySelectorAll<HTMLElement>(".handout[data-week]")];
  async function loadHandouts() {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 12000);
    try {
      const response = await fetch("https://api.github.com/repos/billiswen-png/ai-quant-course/releases?per_page=100", {signal: controller.signal, credentials: "omit"});
      if (!response.ok) throw new Error("Release lookup failed");
      const releases: Release[] = await response.json();
      if (!Array.isArray(releases)) throw new Error("Invalid release list");
      const published = releases.filter(r => !r.draft && !r.prerelease && /^week-0?[1-8]-v\d+(?:\.\d+)*$/.test(r.tag_name))
        .sort((a,b) => Date.parse(b.published_at) - Date.parse(a.published_at));
      let count = 0;
      for (const card of cards) {
        const release = published.find(r => Number(r.tag_name.match(/^week-(\d+)/)?.[1]) === Number(card.dataset.week));
        const state = card.querySelector<HTMLElement>(".handout-state")!;
        const list = card.querySelector<HTMLUListElement>(".handout-files")!;
        const assets = release ? getHandoutFiles(release) : [];
        if (!release || !assets.length) {state.textContent = "尚未發布講義，請留意課堂公告。"; continue;}
        count++;
        const date = new Date(release.published_at).toLocaleDateString("zh-TW", {timeZone:"Asia/Taipei", year:"numeric",month:"2-digit",day:"2-digit"});
        state.textContent = `${release.tag_name}｜發布日期 ${date}`;
        for (const asset of assets) {
          const li = document.createElement("li");
          const link = document.createElement("a");
          link.href = asset.url;
          link.className = "handout-download";
          const size = asset.size === undefined ? "" : `（${(asset.size / 1000000).toFixed(1)} MB）`;
          link.textContent = `下載 ${asset.name}${size}`;
          li.append(link); list.append(li);
        }
      }
      if (status) status.textContent = count ? `已有 ${count} 週講義可下載，以下顯示最近發布的正式版本。` : "講義將依課程進度陸續發布，目前尚無可下載的正式講義。";
    } catch {
      if (status) status.textContent = "暫時無法查詢講義（可能是網路或 GitHub 請求限制），請使用下方 GitHub 連結查看。";
      for (const card of cards) card.querySelector<HTMLElement>(".handout-state")!.textContent = "狀態暫時無法取得，請到 GitHub 確認。";
    } finally {clearTimeout(timeout);}
  }
  loadHandouts();
</script>
<style>
  .handouts { padding-block: 12px 30px; }
  #handout-status { padding: 16px 20px; border-left: 3px solid var(--gold); background: var(--ivory-deep); }
  .handout-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); border-top: 1px solid var(--gold-soft); }
  .handout { min-width: 0; padding: 24px; border-bottom: 1px solid var(--gold-soft); }
  .handout:nth-child(odd) { border-right: 1px solid var(--gold-soft); }
  .handout > span { color: var(--gold); font-weight: 800; }
  .handout h3 { color: var(--navy); font-size: 21px; line-height: 1.5; margin: 8px 0; }
  .handout-state { color: var(--muted); font-size: 14px; }
  .handout-files { list-style: none; padding: 0; margin: 0; }
  .handout-download { display: block; padding: 12px 16px; margin-top: 10px; color: var(--white); background: var(--navy); border-bottom: 3px solid var(--gold); overflow-wrap: anywhere; font-weight: 700; }
  .handout-download:hover { background: var(--navy-2); }
  @media(max-width:760px) {.handout-grid { grid-template-columns: 1fr; } .handout:nth-child(odd) { border-right: 0; } .handout { padding: 22px 8px; }}
</style>
