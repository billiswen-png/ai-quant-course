---
type Submission = { url: string; deadline: string; fileLimitMB: number };
// Add only tested, restricted responder links. Never put student details here.
const submissions: Partial<Record<string, Submission>> = {};
const slots = Array.from({length: 8}, (_, index) => {
  const week = index + 1;
  const prefix = "W" + String(week).padStart(2, "0");
  return {
    week,
    title: week === 7 ? "課內驗收" : week === 8 ? "正式成果" : "課程作業",
    items: week === 8
      ? [{code: prefix + "-G", label: "小組正式成果", limit: 100, formats: "格式不限"}]
      : [
          {code: prefix + "-I", label: "個人作業", limit: 100, formats: "格式不限"},
          {code: prefix + "-G", label: week === 7 ? "小組原型與驗證" : "小組作業", limit: 100, formats: "格式不限"},
        ],
  };
});
const dateFormat = new Intl.DateTimeFormat("zh-TW", {
  timeZone: "Asia/Taipei", year: "numeric", month: "2-digit", day: "2-digit",
  hour: "2-digit", minute: "2-digit", hourCycle: "h23",
});
function getSubmission(code: string) {
  const entry = submissions[code];
  if (!entry || !Number.isFinite(Date.parse(entry.deadline))) return null;
  // Accept full Google Forms responder URLs, not editing URLs or Drive folder links.
  if (!/^https:\/\/docs\.google\.com\/forms\/d\/e\/[\w-]+\/viewform$/.test(entry.url)) return null;
  return entry;
}
---
<section class="submissions" id="submissions" aria-labelledby="submissions-title">
  <p class="page-kicker">個人實作・分組成果</p>
  <h2 id="submissions-title" class="section-heading">作業繳交</h2>
  <p>第 1–7 週依公告分開繳交個人與小組作業；第 8 週正式成果另行繳交，不覆蓋第 7 週原型。</p>
  <ul class="submission-rules">
    <li>個人每人一份；全班 6 組，小組作業由每組一位代表繳交。</li>
    <li>每次繳交一個檔案，格式不限，單檔上限 100 MB；多個檔案請打包成一個 ZIP，無須轉成 PDF。</li>
    <li>表單開放後，請用事先登記的 Google 帳號登入。送出後確認成功畫面；補交依授課公告，不自行覆蓋舊版。</li>
    <li>程式與壓縮檔請先移除 API 金鑰、憑證、帳戶資料和真實交易日誌。</li>
  </ul>
  <div class="submission-grid">
    {slots.map(({week, title, items}) => (
      <article class="submission-week">
        <h3>第 {week} 週｜{title}</h3>
        <ul>
          {items.map(({code, label, limit, formats}) => {
            const entry = getSubmission(code);
            return <li id={code}>
              <strong>{label}</strong>
              <small>{formats}・1 個檔案・課程上限 {limit} MB</small>
              {entry ? <>
                <small>截止：<time datetime={entry.deadline}>{dateFormat.format(new Date(entry.deadline))}</time>（台灣時間）</small>
                {entry.fileLimitMB < limit && <small>本表單單檔上限：{entry.fileLimitMB} MB</small>}
                <a class="text-link" href={entry.url} aria-label={`第 ${week} 週：${label}，前往 Google 表單`}>前往繳交 →</a>
              </> : <span class="submission-pending">尚未開放</span>}
            </li>;
          })}
        </ul>
      </article>
    ))}
  </div>
  <p class="submission-note">公開網站不接收作業檔案。開放後檔案只透過指定表單收取，不會公開在教材下載區。</p>
</section>
<style>
  .submissions { scroll-margin-top: 100px; margin-bottom: 52px; }
  .submission-rules { padding-left: 1.4rem; margin-bottom: 24px; }
  .submission-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,250px),1fr)); gap: 14px; }
  .submission-week { border: 1px solid var(--gold-soft); background: var(--white); padding: 16px 18px; min-width: 0; }
  .submission-week h3 { color: var(--navy); margin: 0 0 8px; }
  .submission-week ul { list-style: none; padding: 0; margin: 0; }
  .submission-week li { display: grid; gap: 3px; padding: 10px 0; border-top: 1px solid var(--gold-soft); }
  .submission-week small, .submission-note { color: var(--muted); }
  .submission-pending { color: var(--navy); width: fit-content; background: var(--ivory-deep); padding: 1px 8px; font-size: .875rem; }
  .submission-week a { width: fit-content; }
</style>
